# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase access; never prefix with NEXT_PUBLIC_
# Preferred modern, rotatable key for new environments
SUPABASE_SECRET_KEY=
# Legacy fallback for the existing production environment only
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only Meta Facebook Login for Business configuration
# Adbot deploys directly to the single live environment.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_STATE_SECRET=
META_TOKEN_ENCRYPTION_KEY=

# Server-only OpenAI Advertiser API connector configuration
# Generate with: openssl rand -base64 32
# This key encrypts customer-provided Ads API keys. Do not reuse OPENAI_API_KEY.
OPENAI_ADS_TOKEN_ENCRYPTION_KEY=

# Server-only Vercel Cron authentication; use at least 32 random characters.
CRON_SECRET=

# Optional: site-admin user UUID used as uploader for ChatGPT Ad Library crawl imports.
# If unset, the first row in site_admins is used.
# CHATGPT_AD_LIBRARY_UPLOADER_USER_ID=

# Canonical application URLs
NEXT_PUBLIC_APP_URL=https://app.adbot.one
NEXT_PUBLIC_MARKETING_URL=https://adbot.one
NEXT_PUBLIC_FUNNEL_URL=https://funnel.adbot.one
NEXT_PUBLIC_FREEBIE_URL=https://freebie.adbot.one

# Shared with Funnel (funnel.adbot.one) — identical value, ≥32 chars
FUNNEL_SSO_SECRET=

# Shared with Freebie (freebie.adbot.one) — identical value, ≥32 chars
FREEBIE_SSO_SECRET=

# KIready OIDC (Phase 1). Production Client-ID is public; the secret stays
# server-only in Vercel as KIREADY_OIDC_CLIENT_SECRET. Token exchange uses
# HTTP Basic (client_secret_basic). STATE_SECRET is optional Adbot HMAC and
# falls back to CLIENT_SECRET when unset.
# KIREADY_OIDC_ISSUER=https://vlqtujjdjxxsdfffcvdj.supabase.co/auth/v1
# KIREADY_OIDC_CLIENT_ID=657c70b6-63f2-43f5-a00d-e22574d18add
# KIREADY_OIDC_CLIENT_SECRET=
# KIREADY_OIDC_REDIRECT_URI=https://app.adbot.one/auth/kiready/callback
# KIREADY_CONTEXT_URL=https://kiready.co/api/v1/integrations/adbot/context
# KIREADY_PORTAL_URL=https://kiready.co/portal
# NEXT_PUBLIC_KIREADY_PORTAL_URL=https://kiready.co/portal
# KIREADY_STATE_SECRET=
# Optional AES-256-GCM key (base64 32 bytes) to store KIready tokens server-side
# KIREADY_TOKEN_ENCRYPTION_KEY=
# Phase 2 (not implemented): entitlement webhooks. Event ids are
# stripe:<stripe_event_id> and kiready:<uuidv7>.
# KIREADY_ENTITLEMENT_HMAC_SECRET=

# Ad-copy suggestions (swappable provider; start with openai)
# AD_COPY_PROVIDER=openai
# OPENAI_API_KEY=
# AD_COPY_OPENAI_MODEL=gpt-4o-mini
# Prices in EUR per 1M tokens (used for Credit markup 1.5×; 1 Credit = 0.01 EUR)
# AD_COPY_OPENAI_INPUT_EUR_PER_MTOK=0.14
# AD_COPY_OPENAI_OUTPUT_EUR_PER_MTOK=0.55
# Private cross-platform Adbot Intelligence endpoint (opt-in after eval)
# AD_COPY_PROVIDER=adbot_intelligence
# TOGETHER_API_KEY=
# AD_COPY_TOGETHER_MODEL=your-project-slug/adbot-cross-platform-v1
# Required before activation: allocate the dedicated endpoint's measured
# per-minute hosting cost to effective EUR per 1M input/output tokens.
# AD_COPY_TOGETHER_INPUT_EUR_PER_MTOK=
# AD_COPY_TOGETHER_OUTPUT_EUR_PER_MTOK=

# Creative asset generation. Leave CREATIVE_ASSET_PROVIDER_KEY empty to keep
# the provider disabled. For OpenRouter use the openrouter block; for a custom
# HTTP provider set all three HTTP variables together.
# CREATIVE_ASSET_PROVIDER_KEY=openrouter
# CREATIVE_ASSET_STORAGE_BUCKET=creative-assets
# CREATIVE_ASSET_OPENROUTER_API_KEY=
# CREATIVE_ASSET_OPENROUTER_MODEL_ALLOWLIST=
# CREATIVE_ASSET_OPENROUTER_DEFAULT_MODEL=
# CREATIVE_ASSET_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# CREATIVE_ASSET_OPENROUTER_ASSET_HOSTS=
# CREATIVE_ASSET_OPENROUTER_TIMEOUT_MS=120000
# CREATIVE_ASSET_OPENROUTER_HTTP_REFERER=https://app.adbot.one
# CREATIVE_ASSET_OPENROUTER_APP_TITLE=Adbot.one
# CREATIVE_ASSET_PROVIDER_ENDPOINT=
# CREATIVE_ASSET_PROVIDER_API_KEY=
# CREATIVE_ASSET_PROVIDER_ASSET_HOSTS=
# CREATIVE_ASSET_PROVIDER_TIMEOUT_MS=120000

# Existing organic-boost delivery watchdog. Current behavior is enabled when
# unset; set explicitly to 0 for the operational kill switch.
ORGANIC_BOOST_DELIVERY_WATCHDOG=1
