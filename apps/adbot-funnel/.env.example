# Admin session (required for /admin)
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
ADMIN_NAME=Adbot Admin

# Shared with Adbot portal (app.adbot.one) — identical value, ≥32 chars
FUNNEL_SSO_SECRET=replace-with-shared-sso-secret-at-least-32-chars
# Optional comma-separated extra shared hosts (keep /f/:slug). Defaults include funnel.adbot.one + *.vercel.app
# FUNNEL_SHARED_HOSTS=funnel.staging.example
# VITE_FUNNEL_SHARED_HOSTS=funnel.staging.example

# Auto-attach customer domains to THIS Funnel Vercel project (no manual Domains UI)
# Create token: Vercel → Account Settings → Tokens (scope: domains)
ADBOT_VERCEL_API_TOKEN=
# Usually injected by Vercel; set explicitly if missing
# VERCEL_PROJECT_ID=
# Optional if the project belongs to a team
# VERCEL_TEAM_ID=

# Funnel data + private file storage (Supabase) — eigenes Projekt, nicht Social Recruiting
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=application-resumes

# Transactional email (Resend)
RESEND_API_KEY=
MAIL_FROM=Adbot Funnel <funnel@example.com>
