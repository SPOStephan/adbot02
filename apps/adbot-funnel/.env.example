# Admin session (required for /admin)
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
ADMIN_NAME=Adbot Admin

# Funnel data + private file storage (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=application-resumes

# Transactional email (Resend)
RESEND_API_KEY=
MAIL_FROM=Adbot Funnel <funnel@example.com>
