# Admin session (required for /admin)
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
ADMIN_NAME=Adbot Admin

# Shared with Adbot portal (app.adbot.one) — identical value, ≥32 chars
FREEBIE_SSO_SECRET=replace-with-shared-sso-secret-at-least-32-chars
# Portal base URL for domain sync (optional; default https://app.adbot.one)
# ADBOT_PORTAL_URL=https://app.adbot.one

# Freebie data (Supabase) — eigenes Projekt oder shared Adbot-DB mit freebie_* Tabellen
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bunny.net Storage + CDN (Media Library / Freebie files)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_REGION=de
BUNNY_CDN_HOSTNAME=

# Transactional email (Resend)
RESEND_API_KEY=
MAIL_FROM=Adbot Freebie <freebie@example.com>

# Public base URL of this app (DOI links)
PUBLIC_APP_URL=https://freebie.adbot.one
